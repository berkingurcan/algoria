{
  "name": "algoria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev --env-file cloudflare.env",
    "deploy": "pnpm build && wrangler deploy --env-file cloudflare.env && sleep 8 && pnpm smoke",
    "smoke": "node scripts/smoke.mjs",
    "ops:uncertain": "node --env-file-if-exists=.env scripts/operator-uncertain.mjs",
    "cf-typegen": "wrangler types",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "provider:register": "node scripts/register-provider.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.5.0",
    "@lucide/svelte": "^1.31.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@stellar/stellar-sdk": "16.2.0",
    "@supabase/supabase-js": "2.112.3",
    "@trionlabs/stellar8004": "0.0.11",
    "@x402/core": "2.22.0",
    "@x402/fetch": "2.22.0",
    "@x402/stellar": "2.22.0",
    "ajv": "8.20.0",
    "buffer": "6.0.3",
    "jose": "6.2.8",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.2.0",
    "svelte": "5.56.9",
    "svelte-check": "^4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.4",
    "vitest": "^4.0.0",
    "wrangler": "4.123.0"
  },
  "pnpm": {
    "overrides": {
      "@sveltejs/kit>cookie": "0.7.2",
      "jayson>uuid": "11.1.1",
      "axios": "1.19.0",
      "protobufjs": "7.6.5"
    }
  }
}
