# Public application origin. Use HTTPS outside localhost.
PUBLIC_APP_ORIGIN=http://localhost:5173

# Supabase local defaults (`supabase status -o env`). Never expose the secret key.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Algoria signs short-lived session tokens after SEP-10. This secret is verified
# only by Algoria. Use a dedicated >=32-byte value (`openssl rand -hex 32`) and
# never the Supabase project JWT secret: sharing it would make a session cookie
# a live database credential.
ALGORIA_JWT_SECRET=
ALGORIA_SESSION_PEPPER=
SEP10_SIGNING_SECRET=

# OpenRouter is server-only. The model is intentionally configurable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Lean v0 executes only allowlisted Stellar 8004 services on testnet.
# Open registry search, Bazaar, MCP execution, MPP, A2A, feedback, and mainnet are disabled.
ALGORIA_ALLOWED_AGENT_IDS=
# Stellar 8004 leaves inputExample optional, so an allowlisted service that did not
# declare one cannot be compiled into a reviewable request. Supply the shape here,
# keyed by "<agentId>" or "<agentId>:<serviceName>". Operator-authored, never agent-declared.
# ALGORIA_SERVICE_PROFILES={"10":{"inputExample":{"url":"https://example.com"}}}
# Gateway used to read ipfs:// agent metadata over HTTPS; the CID stays the identifier.
# ALGORIA_IPFS_GATEWAY=https://ipfs.io/ipfs/
# x402.org settles Stellar testnet only. Mainnet needs a pubnet-capable facilitator,
# e.g. https://channels.openzeppelin.com/x402 (key from channels.openzeppelin.com/gen).
# ALGORIA_FACILITATOR_URL=
PUBLIC_STELLAR_NETWORK=stellar:testnet
STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
MAX_PAYMENT_USDC=1

# Controlled deterministic provider. The recipient must be a Stellar testnet
# G-address able to receive the configured testnet USDC SAC. No secret key is used.
ALGORIA_PROVIDER_PAY_TO=
ALGORIA_PROVIDER_AGENT_ID=
# Optional secret used only by the adversarial harness to request response-loss mode.
ALGORIA_PROVIDER_TEST_TOKEN=
